Package: ef
Title: Modelling Framework for the Estimation of Salmonid Abundance
Version: 2.0.0
Date: 2026-10-09
Authors@R:
  c(
    person("Colin", "Millar", role = c("aut", "cre"),
                    email = "colin.millar@ices.dk"),
    person("Rob", "Fryer", role = "aut"),
